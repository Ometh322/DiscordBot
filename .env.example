# Токен Discord-бота: Discord Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# Токен ВК со скоупом audio (получить: venv\Scripts\python scripts\get_vk_token.py)
VK_TOKEN=

# Заполняются скриптом get_vk_token.py автоматически, вручную не менять:
# User-Agent клиента Kate Mobile (обязателен для audio.*)
VK_USER_AGENT=
# Версия VK API, на которой работают audio-методы
VK_API_VERSION=

# Путь к ffmpeg.exe. Можно оставить "ffmpeg", если он доступен в PATH.
FFMPEG_PATH=ffmpeg

# Громкость приветствий (множитель): 4.0 = в 4 раза громче (~+12 дБ)
WELCOME_VOLUME=4.0
