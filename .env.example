# Токен Discord-бота: Discord Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# Громкость приветствий (множитель): 10 = сильно громче (лимитер убирает перегруз)
WELCOME_VOLUME=10

# FFmpeg указывать НЕ нужно — бинарь ставится через pip (imageio-ffmpeg).
# FFMPEG_PATH задавай, только если хочешь использовать системный ffmpeg.
